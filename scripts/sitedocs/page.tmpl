<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · seedfall docs</title>
<meta name="description" content="{{.Desc}}">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Desc}}">
<link rel="alternate" type="text/markdown" href="{{.Markdown}}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="icon" href="{{.Root}}favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{.Root}}style.css">
<link rel="stylesheet" href="{{.Root}}docs.css">
</head>
<body>
<svg width="0" height="0" class="sprite" aria-hidden="true"><symbol id="gh" viewBox="0 0 16 16"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></symbol></svg>
<header class="nav docs-nav">
  <div class="wrap nav-row">
    <a class="brand" href="{{.Root}}"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>seedfall</a>
    <nav class="links" aria-label="Site">
      <a href="{{.Root}}">Home</a>
      <a href="{{.Docs}}" aria-current="true">Docs</a>
    </nav>
    <a class="gh" href="{{.Repo}}" aria-label="seedfall on GitHub"><svg aria-hidden="true"><use href="#gh"/></svg><span class="gh-stat" hidden><span class="gh-star">Star</span><span class="gh-count"></span></span></a>
  </div>
</header>
<div class="docs">
  <div class="wrap docs-grid">
    <aside class="docs-side">
      <input class="docs-toggle" type="checkbox" id="docs-menu" aria-label="Show the list of docs">
      <label class="docs-menu" for="docs-menu">Docs menu</label>
      <nav class="docs-index" aria-label="Documentation">
{{- range .Groups}}
        <h2>{{.Name}}</h2>
        <ul>
{{- range .Items}}
          <li><a href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
{{- end}}
        </ul>
{{- end}}
      </nav>
    </aside>
    <main class="docs-main">
      <p class="docs-meta">
{{- if .CrumbHref}}<a href="{{.CrumbHref}}">&larr; {{.CrumbLabel}}</a>{{end}}
        <a href="{{.Markdown}}" type="text/markdown">View as Markdown, for AI agents</a>
        <a href="{{.Source}}">Edit on GitHub</a>
      </p>
      <article class="prose">
{{.Body}}
      </article>
    </main>
  </div>
</div>
<footer class="foot">
  <div class="wrap foot-row">
    <a class="brand" href="{{.Root}}"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>seedfall</a>
    <p>Deterministic simulation testing for Go · <a href="{{.Repo}}">Source on GitHub</a> · <a href="{{.Root}}llms.txt">llms.txt</a></p>
  </div>
</footer>
<script src="{{.Root}}stars.js" defer></script>
</body>
</html>
