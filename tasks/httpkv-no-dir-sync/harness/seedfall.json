{
  "duration": "30s",
  "faults": {
    "crash_on_io": 0.005,
    "crash_per_sec": 1,
    "restart_after": [
      "10ms",
      "300ms"
    ],
    "strict_dirs": true,
    "torn_writes": true
  },
  "net_overlay": true,
  "nodes": [
    {
      "name": "server",
      "pkg": "./server"
    }
  ],
  "watchdog": "180s",
  "workload": {
    "name": "client",
    "pkg": "./client"
  }
}
