{
  "nodes": [
    { "name": "n1", "pkg": "./node", "args": ["-local-reads"] },
    { "name": "n2", "pkg": "./node", "args": ["-local-reads"] },
    { "name": "n3", "pkg": "./node", "args": ["-local-reads"] }
  ],
  "workload": { "name": "client", "pkg": "./linclient" },
  "duration": "120s",
