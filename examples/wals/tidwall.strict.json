{
  "nodes": [{ "name": "server", "pkg": "./tidwall" }],
  "workload": { "name": "client", "pkg": "./client", "args": ["-appends", "200"] },
  "duration": "60s",
  "latency": ["1ms", "5ms"],
  "faults": {
    "crash_per_sec": 0.5,
    "restart_after": ["10ms", "500ms"],
    "torn_writes": true,
    "crash_on_io": 0.005,
    "strict_dirs": true
  }
}
