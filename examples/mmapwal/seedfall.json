{
  "nodes": [
    { "name": "server", "pkg": "./server", "args": ["-dir", "data"] }
  ],
  "workload": { "name": "client", "pkg": "github.com/kunalgoesbyken/seedfall/examples/kvlog/client", "args": ["-writes", "120"] },
  "duration": "30s",
  "latency": ["1ms", "5ms"],
  "compat_overlay": true,
  "faults": {
    "crash_per_sec": 1,
    "restart_after": ["10ms", "200ms"]
  },
  "profiles": {
    "early": { "faults": { "mmap_early_writeback": 0.5 } },
    "fixed": {
      "faults": { "mmap_early_writeback": 0.5 },
      "nodes": [{ "name": "server", "args": ["-dir", "data", "-lenient"] }]
    }
  }
}
