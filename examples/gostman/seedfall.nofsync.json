{
  "nodes": [{ "name": "server", "pkg": "httpkv/server", "args": ["-fsync=false"] }],
  "workload": { "name": "client", "pkg": "./client" },
  "duration": "60s",
  "net_overlay": true,
  "watchdog": "300s",
  "faults": {
    "crash_per_sec": 0.5,
    "restart_after": ["10ms", "300ms"],
    "torn_writes": true,
    "crash_on_io": 0.005,
    "partition_per_sec": 0.2
  }
}
