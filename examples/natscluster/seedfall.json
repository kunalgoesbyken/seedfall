{
  "nodes": [
    {
      "name": "n1",
      "pkg": "./node"
    },
    {
      "name": "n2",
      "pkg": "./node"
    },
    {
      "name": "n3",
      "pkg": "./node"
    }
  ],
  "workload": {
    "name": "client",
    "pkg": "./client"
  },
  "duration": "180s",
  "latency": [
    "1ms",
    "8ms"
  ],
  "net_overlay": true,
  "watchdog": "180s",
  "faults": {
    "crash_per_sec": 0.1,
    "restart_after": [
      "50ms",
      "1s"
    ],
    "partition_per_sec": 0.2,
    "partition_for": [
      "100ms",
      "2s"
    ],
    "torn_writes": true,
    "crash_on_io": 0.002
  },
  "profiles": {
    "pause": {
      "faults": {
        "clock_jump_max": "5s",
        "clock_jump_per_sec": 0.1,
        "crash_on_io": 0,
        "partition_for": ["50ms", "2s"],
        "partition_per_sec": 0,
        "pause_for": ["200ms", "3s"],
        "pause_per_sec": 0.5
      }
    },
    "r1.nosync": {
      "faults": { "crash_on_io": 0, "crash_per_sec": 0.3, "partition_for": ["50ms", "2s"], "partition_per_sec": 0 },
      "nodes": [
        { "name": "n1", "args": ["-sync-always=false"] },
        { "name": "n2", "args": ["-sync-always=false"] },
        { "name": "n3", "args": ["-sync-always=false"] }
      ],
      "workload": { "args": ["-replicas", "1", "-messages", "60"] }
    },
    "strict": { "faults": { "strict_dirs": true } }
  }
}
