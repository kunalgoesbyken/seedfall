{
  "nodes": [
    {
      "name": "n1",
      "pkg": "./node",
      "args": [
        "-sync-always=false"
      ]
    },
    {
      "name": "n2",
      "pkg": "./node",
      "args": [
        "-sync-always=false"
      ]
    },
    {
      "name": "n3",
      "pkg": "./node",
      "args": [
        "-sync-always=false"
      ]
    }
  ],
  "workload": {
    "name": "client",
    "pkg": "./client",
    "args": [
      "-replicas",
      "1",
      "-messages",
      "60"
    ]
  },
  "duration": "180s",
  "latency": [
    "1ms",
    "8ms"
  ],
  "net_overlay": true,
  "watchdog": "180s",
  "faults": {
    "crash_per_sec": 0.3,
    "restart_after": [
      "50ms",
      "1s"
    ],
    "torn_writes": true
  }
}
