{
  "nodes": [
    { "name": "server", "pkg": "./server" }
  ],
  "workload": { "name": "client", "pkg": "./client", "args": ["-writes", "300"] },
  "duration": "60s",
  "latency": ["1ms", "5ms"],
  "compat_overlay": true,
  "faults": {
    "crash_per_sec": 0.5,
    "restart_after": ["10ms", "500ms"],
    "partition_per_sec": 0.2,
    "partition_for": ["50ms", "1s"],
    "strict_dirs": true
  },
  "profiles": {
    "nosync": { "nodes": [{ "name": "server", "args": ["-nosync"] }] },
    "torn": { "faults": { "crash_on_io": 0.005, "torn_writes": true } }
  }
}
