{
  "nodes": [
    { "name": "n1", "pkg": "./node", "args": ["-transport", "grpc"] },
    { "name": "n2", "pkg": "./node", "args": ["-transport", "grpc"] },
    { "name": "n3", "pkg": "./node", "args": ["-transport", "grpc"] }
  ],
  "workload": { "name": "client", "pkg": "./linclient" },
  "duration": "120s",
  "latency": ["1ms", "8ms"],
  "net_overlay": true,
  "supervise": true,
  "watchdog": "30s",
  "faults": {
    "crash_per_sec": 0.15,
    "restart_after": ["50ms", "1s"],
    "partition_per_sec": 0.2,
    "partition_for": ["100ms", "2s"]
  }
}
