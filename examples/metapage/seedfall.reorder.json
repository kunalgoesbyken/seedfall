{
  "nodes": [
    { "name": "server", "pkg": "./server", "args": ["-dir", "data"] }
  ],
  "workload": { "name": "client", "pkg": "../kvlog/client", "args": ["-writes", "200"] },
  "duration": "60s",
  "latency": ["1ms", "5ms"],
  "faults": {
    "crash_per_sec": 0.5,
    "restart_after": ["10ms", "500ms"],
    "torn_writes": true,
    "reorder_writes": true,
    "crash_on_io": 0.01
  }
}
