{
  "nodes": [
    { "name": "n1", "pkg": "./node", "args": ["-id", "1"] },
    { "name": "n2", "pkg": "./node", "args": ["-id", "2"] },
    { "name": "n3", "pkg": "./node", "args": ["-id", "3"] }
  ],
  "workload": { "name": "client", "pkg": "./linclient" },
  "duration": "120s",
  "latency": ["1ms", "8ms"],
  "faults": {
    "crash_per_sec": 0.15,
    "restart_after": ["50ms", "1s"],
    "partition_per_sec": 0.2,
    "partition_for": ["100ms", "2s"],
    "torn_writes": true,
    "crash_on_io": 0.002
  },
  "profiles": {
    "nofsync": {
      "nodes": [
        { "name": "n1", "args": ["-id", "1", "-no-fsync"] },
        { "name": "n2", "args": ["-id", "2", "-no-fsync"] },
        { "name": "n3", "args": ["-id", "3", "-no-fsync"] }
      ]
    },
    "strict": { "faults": { "strict_dirs": true } }
  }
}
