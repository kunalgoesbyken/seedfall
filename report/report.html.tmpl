<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>seedfall triage report · {{.Config}}</title>
<link rel="icon" href="{{icon}}" type="image/svg+xml">
<style>
{{theme}}
main { max-width: 64rem; margin: 2rem auto 8rem; padding: 1.5rem; }
@media (min-width: 768px) { main { margin-top: 6rem; } }
h1 { margin: 0; font-size: 1.875rem; overflow-wrap: anywhere; }
h2 { margin: 3.5rem 0 1rem; font-size: 1.25rem; }
.brand { margin: 0 0 1.5rem; color: var(--faint); font-size: 0.875rem; }
.meta { margin-top: 1rem; color: var(--faint); font-size: 0.875rem; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin-top: 28px; border-top: 1px solid var(--rule); }
.stats div { padding: 18px 0; }
.stats b { display: block; color: var(--fg); font-size: 1.875rem; font-weight: 650; font-variant-numeric: tabular-nums; }
.finding { padding: 24px 0; border-top: 1px solid var(--rule); }
.finding header { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: baseline; }
.finding h3 { font-size: 18px; font-weight: 500; }
.finding > * + * { margin-top: 12px; }
.finding > .note { margin-top: 8px; }
.badge { padding: 2px 8px; border: 1px solid currentColor; font: 12px var(--mono); }
.new, .regressed { color: var(--bad); }
.ongoing { color: var(--warn); }
.resolved { color: var(--ok); }
.not-seen { color: var(--muted); }
pre { padding: 14px 16px; overflow-x: auto; border: 1px solid var(--rule); background: var(--wash); font-size: 12.5px; line-height: 1.65; }
summary { color: var(--muted); cursor: pointer; }
summary:hover { color: var(--fg); }
details > :not(summary) { margin-top: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
th { color: var(--muted); font: 500 12px var(--mono); }
td.num { font-family: var(--mono); white-space: nowrap; font-variant-numeric: tabular-nums; }
.problem { color: var(--bad); }
.empty { padding: 18px 0; border-top: 1px solid var(--rule); color: var(--ok); }
button.copy { padding: 4px 10px; border: 1px solid var(--rule); background: transparent; color: var(--fg); font: 13px var(--mono); cursor: pointer; transition: border-color .2s; }
button.copy:hover { border-color: var(--fg); }
iframe.timeline { width: 100%; height: 80vh; border: 1px solid var(--rule); background: var(--bg); }
textarea.issue { width: 100%; height: 220px; padding: 12px; font-size: 12.5px; line-height: 1.6; }
</style>
</head>
<body>
<main>
  <p class="brand">seedfall triage report</p>
  <h1>{{.Config}}</h1>
  <p class="mono meta">seeds {{.Seeds}} · {{.Elapsed}} · {{printf "%.1f" .SeedsPerSec}} seeds/s · {{printf "%.0f" .VirtualPerWall}}x virtual time · seedfall {{.Version}} · {{.GoVersion}}{{with .Commit}} · commit {{.}}{{end}} · {{.Generated.Format "2006-01-02 15:04 MST"}}</p>

  <div class="stats">
    <div><b>{{.Total}}</b><span class="dim">seeds run</span></div>
    <div><b>{{.Passed}}</b><span class="dim">passed</span></div>
    <div><b>{{.Failed}}</b><span class="dim">failed</span></div>
    <div><b>{{len .Findings}}</b><span class="dim">distinct findings</span></div>
  </div>

  {{if .Regressions}}
  <h2>Regressions</h2>
  <table>
    <tr><th>result</th><th>seed</th><th>source</th><th>failure</th></tr>
    {{range .Regressions}}
    <tr><td class="mono {{if .Passed}}resolved{{else}}regressed{{end}}">{{if .Passed}}pass{{else}}FAIL{{end}}</td><td class="num">{{.Seed}}</td><td class="mono">{{.Source}}</td><td>{{if not .Passed}}{{.Failure.Key}}: {{.Reason}}{{with .Artifacts}} <span class="dim mono">· artifacts {{.}}</span>{{end}}{{end}}</td></tr>
    {{end}}
  </table>
  {{end}}

  <h2>Findings</h2>
  {{if not .Findings}}<p class="empty">No failures in {{.Total}} seeds.</p>{{end}}
  {{range $f := .Findings}}
  <section class="finding">
    <header>
      <span class="badge {{.Status}}">{{.Status}}</span>
      <h3>{{.Key}}</h3>
      <span class="dim mono">{{.Count}} seeds · {{percent .Rate}}{{if .Rare}} · rare{{end}}{{with .Classification}} · {{.}}{{end}}</span>
    </header>
    {{with .Example}}
    <p>{{.Reason}}</p>
    <p class="dim mono">example seeds: {{range $i, $s := $f.Seeds}}{{if $i}}, {{end}}{{$s}}{{end}}</p>
    <pre>{{.Replay}}
{{.Shrink}}</pre>
    {{if .Faults}}<pre>faults before the failure ({{len .Faults}}):
{{range .Faults}}  {{.}}
{{end}}</pre>{{end}}
    <details><summary>trace of seed {{.Seed}}, failing at t={{.At}}</summary><pre>{{range .Trace}}{{.}}
{{end}}</pre></details>
    {{with .Artifacts}}<p class="dim mono">artifacts: {{.}}</p>{{end}}
    {{with .Timeline}}<details><summary>timeline of seed {{$f.Example.Seed}}: nodes, messages, faults, operations and the trace explorer · <a href="{{.}}">open on its own</a></summary><iframe class="timeline" src="{{.}}" loading="lazy" title="timeline of seed {{$f.Example.Seed}}"></iframe></details>{{end}}
    {{end}}
    <button class="copy" type="button">Copy issue markdown</button>
    <details><summary>issue markdown</summary><textarea class="issue" readonly>{{$.IssueMarkdown $f}}</textarea></details>
  </section>
  {{end}}

  {{if .Cleared}}
  <h2>Previous findings not seen</h2>
  {{range .Cleared}}
  <section class="finding">
    <header><span class="badge {{if eq .Status "resolved"}}resolved{{else}}not-seen{{end}}">{{.Status}}</span><h3>{{.Key}}</h3></header>
    <p class="dim note">{{.Note}}</p>
  </section>
  {{end}}
  {{end}}

  {{if .Exploration}}
  <h2>Exploration</h2>
  <p class="dim">{{with .Stopped}}Stopped: {{.}}. {{end}}How the signal set grew: each row is one batch of runs.</p>
  <table>
    <tr><th>round</th><th>runs</th><th>new signals</th><th>signals</th><th>new functions</th><th>functions</th><th>corpus</th><th>failures</th></tr>
    {{range .Exploration}}<tr><td class="num">{{.Round}}</td><td class="num">{{.Runs}}</td><td class="num">{{.NewSignals}}</td><td class="num">{{.Signals}}</td><td class="num">{{.NewFunctions}}</td><td class="num">{{.Functions}}</td><td class="num">{{.Corpus}}</td><td class="num">{{.Failures}}</td></tr>{{end}}
  </table>
  {{end}}

  {{if not .Exploration}}{{with .Stopped}}<p class="dim">Stopped: {{.}}.</p>{{end}}{{end}}
  {{with .Utilization}}
  <h2>Utilization</h2>
  <p class="dim">{{.Advice}}</p>
  <p class="dim mono">{{.Outcomes}} property outcomes · speedup per seed {{printf "%.0f" .SpeedupMin}}x min, {{printf "%.0f" .SpeedupMedian}}x median, {{printf "%.0f" .SpeedupMax}}x max</p>
  <table>
    <tr><th>seeds</th><th>new property outcomes</th></tr>
    {{range .Batches}}<tr><td class="num">{{.From}}-{{.To}}</td><td class="num">{{.New}}</td></tr>{{end}}
  </table>
  {{end}}

  <h2>Properties</h2>
  {{if not .Properties}}<p class="dim">No properties declared. Add sim.Always, sim.Sometimes or sim.Reachable to know which paths the faults reached.</p>{{else}}
  <table>
    <tr><th>kind</th><th>property</th><th>seeds reached</th><th>seeds true</th><th>location</th></tr>
    {{range .Properties}}
    <tr><td class="mono">{{.Kind}}</td><td>{{.Message}}{{if .Problem}} <span class="problem">· {{.Problem}}</span>{{end}}{{if .MarginNote}} <span class="dim">· {{.MarginNote}}</span>{{end}}</td><td class="num">{{.SeedsReached}}</td><td class="num">{{.SeedsTrue}}</td><td class="mono dim">{{.Location}}</td></tr>
    {{end}}
  </table>
  {{end}}

  <h2>Fault profile</h2>
  <table>
    {{if .Faults.Preset}}<tr><td>preset</td><td class="num">{{.Faults.Preset}}</td></tr>{{end}}
    <tr><td>crashes per second per node</td><td class="num">{{.Faults.CrashPerSec}}</td></tr>
    <tr><td>partitions per second</td><td class="num">{{.Faults.PartitionPerSec}}</td></tr>
    <tr><td>partition topologies</td><td class="num">{{range $i, $t := .Faults.PartitionTopologies}}{{if $i}} · {{end}}{{$t}}{{end}}</td></tr>
    <tr><td>clogs · swizzles per second</td><td class="num">{{.Faults.ClogPerSec}} · {{.Faults.SwizzlePerSec}}</td></tr>
    <tr><td>connection resets · slowdowns per second per node</td><td class="num">{{.Faults.ResetPerSec}} · {{.Faults.SlowPerSec}}</td></tr>
    <tr><td>UDP loss · duplication probability per datagram</td><td class="num">{{.Faults.UDPLoss}} · {{.Faults.UDPDup}}</td></tr>
    <tr><td>crash probability per disk operation</td><td class="num">{{.Faults.CrashOnIO}}</td></tr>
    <tr><td>fsync EIO probability</td><td class="num">{{.Faults.FsyncEIO}}</td></tr>
    <tr><td>write EIO · write ENOSPC · read EIO · corrupted read probability</td><td class="num">{{.Faults.WriteEIO}} · {{.Faults.WriteENOSPC}} · {{.Faults.ReadEIO}} · {{.Faults.ReadCorrupt}}</td></tr>
    <tr><td>lost · misdirected write probability per fsync</td><td class="num">{{.Faults.LostWrite}} · {{.Faults.MisdirectedWrite}}</td></tr>
    <tr><td>bit rot per second per node · corrupt on crash · disk bytes</td><td class="num">{{.Faults.BitrotPerSec}} · {{.Faults.CorruptOnCrash}} · {{.Faults.DiskBytes}}</td></tr>
    <tr><td>torn writes · strict directories · swarm</td><td class="num">{{.Faults.TornWrites}} · {{.Faults.StrictDirs}} · {{.Faults.Swarm}}</td></tr>
  </table>
</main>
<script>
for (const button of document.querySelectorAll("button.copy")) {
  button.addEventListener("click", async () => {
    const text = button.parentElement.querySelector("textarea.issue");
    try {
      await navigator.clipboard.writeText(text.value);
    } catch {
      text.closest("details").open = true;
      text.select();
      document.execCommand("copy");
    }
    button.textContent = "Copied";
  });
}
</script>
</body>
</html>
