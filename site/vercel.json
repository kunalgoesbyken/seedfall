{
  "redirects": [
    { "source": "/proof/:path*", "destination": "/docs/findings/:path*", "permanent": true },
    { "source": "/compare.html", "destination": "/docs/faq.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }, { "key": "Content-Disposition", "value": "inline" }]
    }
  ]
}
